# Server only. Copy this file to .env and set your OpenCode Console key.
OPENCODE_API_KEY=
OPENCODE_MODEL=qwen3.8-max
OPENCODE_ENDPOINT=https://opencode.ai/inference/openai/v1/chat/completions
HOST=127.0.0.1
PORT=3000
# Set to a trusted Python image already loaded into a rootless Linux Docker engine.
JUDGE_IMAGE=
